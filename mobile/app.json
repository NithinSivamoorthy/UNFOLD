{
  "expo": {
    "name": "UNFOLD",
    "slug": "unfold",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "unfold",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090B",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "edu.usf.hackjam.unfold",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "UNFOLD connects to your team’s generation server on the local network."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "UNFOLD uses your photos so you can turn a picture into a 3D model.",
          "cameraPermission": "UNFOLD uses the camera to photograph objects and diagrams to turn into 3D models."
        }
      ],
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "UNFOLD uses the camera to photograph objects from several sides for Guided 3D Scan.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
